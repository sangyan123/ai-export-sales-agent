APP_ENV=development
APP_SECRET_KEY=change-me-generate-a-random-64-hex-secret
JWT_SECRET_KEY=
JWT_ISSUER=fastener-ai
JWT_AUDIENCE=fastener-ai-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
LOG_LEVEL=INFO

POSTGRES_DB=fastener_ai
POSTGRES_USER=fastener
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://fastener:change-me@localhost:5433/fastener_ai
MIGRATION_DATABASE_URL=postgresql+psycopg://fastener:change-me@localhost:5433/fastener_ai

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fastener-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# S3 未配置时附件落盘到本地目录
UPLOAD_DIR=var/uploads
ATTACHMENT_MAX_BYTES=20971520

# Docker Compose 前端入口端口
WEB_PORT=8080

LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_CHARS=20000
EMBEDDING_MODEL=

SENTRY_DSN=
